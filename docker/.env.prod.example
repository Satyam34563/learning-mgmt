# Copy to docker/.env.prod on the server and fill in. Never commit the real file.
HTTP_PORT=80

MONGO_ROOT_USER=lectures
MONGO_ROOT_PASSWORD=generate-a-long-random-password

# openssl rand -hex 32
JWT_SECRET=generate-a-long-random-secret
CLIENT_ORIGIN=https://lectures.yourschool.edu

MAX_UPLOAD_MB=25
REQUIRE_LOGIN_TO_VIEW=true
ALLOW_LOCAL_LOGIN=false

# School Management System single sign-on (see README → "SMS login"). Values for ONE school:
SMS_LOGIN_URL=https://yourschool.managemyschools.in/sso/lectures
# Mount the SMS public key into the api container, or paste it inline with \n newlines
SMS_TOKEN_PUBLIC_KEY_FILE=
SMS_TOKEN_PUBLIC_KEY=
SMS_TOKEN_SECRET=
SMS_TOKEN_ISSUER=yourschool.managemyschools.in
SMS_TOKEN_AUDIENCE=https://lectures.yourschool.edu
SMS_ROLE_MAP={"student":"student","teacher":"teacher","admin":"admin","operator":"admin"}
SMS_MOCK=false

# Only used if you run the seed with --admin to create a break-glass local admin
SEED_ADMIN_EMAIL=admin@yourschool.edu
SEED_ADMIN_PASSWORD=
