# Copy to docker/.env.prod on the server and fill in. Never commit the real file.
# One stack per school on the same server: unique project name and local port, host Nginx in front (DEPLOY.md)
COMPOSE_PROJECT_NAME=lectures-dlcs
HTTP_PORT=127.0.0.1:8080

MONGO_ROOT_USER=lectures
MONGO_ROOT_PASSWORD=generate-a-long-random-password

# openssl rand -hex 32
JWT_SECRET=generate-a-long-random-secret
# This school's portal address; the SMS address is derived from it (dlcs.lectures.… -> dlcs.…)
CLIENT_ORIGIN=https://dlcs.lectures.managemyschools.in

MAX_UPLOAD_MB=25
REQUIRE_LOGIN_TO_VIEW=true
ALLOW_LOCAL_LOGIN=false

# School Management System single sign-on (see README → "SMS login").
# Nothing else to set when CLIENT_ORIGIN follows <school>.lectures.managemyschools.in;
# otherwise set SMS_BASE_URL=https://<school>.managemyschools.in
SMS_BASE_URL=
SMS_ROLE_MAP={"student":"student","teacher":"teacher","admin":"admin","operator":"admin"}
SMS_MOCK=false

# Only used if you run the seed with --admin to create a break-glass local admin
SEED_ADMIN_EMAIL=admin@yourschool.edu
SEED_ADMIN_PASSWORD=
