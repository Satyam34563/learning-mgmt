API_PORT=4000
NODE_ENV=development
# Matches docker/docker-compose.dev.yml
MONGO_URI=mongodb://dev:devpassword@127.0.0.1:27017/lectures?authSource=admin
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the web app (the API is reached at <CLIENT_ORIGIN>/api via the Vite proxy / Nginx)
CLIENT_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
REQUIRE_LOGIN_TO_VIEW=false
ALLOW_LOCAL_LOGIN=true

# --- Login via the School Management System (SMS) ---
# One portal per school. The school's SMS signs a 60-second RS256 token at /sso/lectures.
# SMS_LOGIN_URL=https://<school>.managemyschools.in/sso/lectures
SMS_LOGIN_URL=
# Public key matching the SMS's LECTURES_SSO_PRIVATE_KEY_PATH (file path, or inline PEM with \n)
SMS_TOKEN_PUBLIC_KEY_FILE=
SMS_TOKEN_PUBLIC_KEY=
# Shared secret (HS256) instead of a key pair; only used by the dev mock below
SMS_TOKEN_SECRET=dev-sms-shared-secret
# iss = the school's SMS domain, aud = this portal's CLIENT_ORIGIN (leave empty in dev)
SMS_TOKEN_ISSUER=
SMS_TOKEN_AUDIENCE=
# SMS role -> portal role. SMS sends Student, Teacher, Admin or Operator.
SMS_ROLE_MAP={"student":"student","teacher":"teacher","admin":"admin","operator":"admin"}
# Dev only: fake SMS login page so the SSO flow works without the real SMS
SMS_MOCK=true

# Used by `npm run seed` to create local demo accounts
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_PASSWORD=admin12345
