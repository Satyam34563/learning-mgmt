API_PORT=4000
NODE_ENV=development
# Matches docker/docker-compose.dev.yml
MONGO_URI=mongodb://dev:devpassword@127.0.0.1:27017/lectures?authSource=admin
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the web app (the API is reached at <CLIENT_ORIGIN>/api via the Vite proxy / Nginx).
# <school>.lectures.localhost works out of the box in browsers and picks the school (and its SMS) from the name.
CLIENT_ORIGIN=http://dlcs.lectures.localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
REQUIRE_LOGIN_TO_VIEW=false
ALLOW_LOCAL_LOGIN=true

# --- Login via the School Management System (SMS) ---
# The school's SMS address. Login, key, branding URLs, issuer and audience are all derived from it.
# Leave empty when CLIENT_ORIGIN is <school>.lectures.<anything>: it becomes https://<school>.managemyschools.in
# (pattern: SMS_URL_PATTERN). Local testing against a live SMS needs LECTURES_SSO_ALLOW_LOCALHOST=true there.
SMS_BASE_URL=
# Branding normally comes from the SMS school profile; these override it
SCHOOL_NAME=
SCHOOL_SHORT_NAME=
SCHOOL_LOGO_URL=
# SMS role -> portal role. SMS sends Student, Teacher, Admin or Operator.
SMS_ROLE_MAP={"student":"student","teacher":"teacher","admin":"admin","operator":"admin"}
# Dev only: fake SMS login page (HS256 with the secret below) instead of a real SMS
SMS_MOCK=true
SMS_TOKEN_SECRET=dev-sms-shared-secret
# Advanced overrides (normally derived): SMS_LOGIN_URL, SMS_TOKEN_PUBLIC_KEY_URL, SMS_TOKEN_PUBLIC_KEY_FILE,
# SMS_TOKEN_PUBLIC_KEY, SMS_TOKEN_ISSUER, SMS_TOKEN_AUDIENCE

# Used by `npm run seed` to create local demo accounts
SEED_ADMIN_EMAIL=admin@school.local
SEED_ADMIN_PASSWORD=admin12345
