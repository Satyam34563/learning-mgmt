{
  "name": "online-lectures",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.dev.yml down",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:demo": "npm run seed:demo -w server",
    "seed:admin": "npm run seed:admin -w server",
    "import-template": "npm run import-template -w server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
